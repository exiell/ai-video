{
  "name": "aniguide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "description": "AI 动漫视频新手引导工具 —— 把「我想做个动漫视频」变成一份可直接开拍的制作方案",
